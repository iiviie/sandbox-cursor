FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies and useful tools
RUN apt-get update && apt-get install -y \
    libglib2.0-0 \
    libgtk-3-0 \
    libxkbcommon0 \
    libnss3 \
    libx11-6 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libasound2 \
    libxext6 \
    libxtst6 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libgbm1 \
    wget \
    ca-certificates \
    fuse \
    xdg-utils \
    mesa-utils \
    dbus-x11 \
    libdbus-1-3 \
    xvfb \
    x11-xserver-utils \
    software-properties-common \
    gnupg \
    curl \
    sudo \
    vim \
    nano \
    git \
    htop \
    zip \
    unzip \
    python3 \
    python3-pip \
    libfuse2 \
    dbus \
    libxss1 \
    libgconf-2-4 \
    libxtst6 \
    libxrandr2 \
    libasound2 \
    libpangocairo-1.0-0 \
    libatk1.0-0 \
    libcairo-gobject2 \
    libgtk-3-0 \
    libgdk-pixbuf2.0-0 \
    snapd \
 && rm -rf /var/lib/apt/lists/*

# Install browsers - handle both ARM64 and AMD64 architectures
RUN apt-get update && \
    apt-get install -y chromium-browser firefox-esr && \
    rm -rf /var/lib/apt/lists/*

# Try to install Google Chrome if on AMD64, fallback to Chromium on ARM64
RUN ARCH=$(dpkg --print-architecture) && \
    echo "Architecture detected: $ARCH" && \
    if [ "$ARCH" = "amd64" ]; then \
        wget -q -O - https://dl-ssl.google.com/linux/linux_signing_key.pub | apt-key add - && \
        echo "deb [arch=amd64] http://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list && \
        apt-get update && \
        apt-get install -y google-chrome-stable && \
        rm -rf /var/lib/apt/lists/* && \
        PREFERRED_BROWSER="/usr/bin/google-chrome-stable"; \
    else \
        echo "ARM64 detected, using Chromium as primary browser" && \
        PREFERRED_BROWSER="/usr/bin/chromium-browser"; \
    fi

# Create comprehensive browser symlinks for both Chrome and Chromium
RUN if [ -f "/usr/bin/google-chrome-stable" ]; then \
        ln -sf /usr/bin/google-chrome-stable /usr/bin/google-chrome && \
        ln -sf /usr/bin/google-chrome-stable /usr/bin/chrome && \
        ln -sf /usr/bin/google-chrome-stable /usr/bin/browser && \
        ln -sf /usr/bin/google-chrome-stable /usr/local/bin/browser && \
        ln -sf /usr/bin/google-chrome-stable /usr/local/bin/chrome; \
    else \
        ln -sf /usr/bin/chromium-browser /usr/bin/google-chrome && \
        ln -sf /usr/bin/chromium-browser /usr/bin/chrome && \
        ln -sf /usr/bin/chromium-browser /usr/bin/browser && \
        ln -sf /usr/bin/chromium-browser /usr/local/bin/browser && \
        ln -sf /usr/bin/chromium-browser /usr/local/bin/chrome && \
        ln -sf /usr/bin/chromium-browser /usr/bin/google-chrome-stable; \
    fi && \
    ln -sf /usr/bin/chromium-browser /usr/bin/firefox

# Set up locale
RUN apt-get update && apt-get install -y locales && \
    locale-gen en_US.UTF-8 && \
    update-locale LANG=en_US.UTF-8 && \
    rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# Create a non-root user
RUN useradd -u 1000 -ms /bin/bash cursoruser

# Add the user to the sudo group and configure passwordless sudo
RUN usermod -aG sudo cursoruser && \
    echo "cursoruser ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/cursoruser && \
    chmod 0440 /etc/sudoers.d/cursoruser

# Create necessary directories and set permissions
RUN mkdir -p /home/cursoruser/.cursor && \
    mkdir -p /home/cursoruser/.cursor/extensions && \
    mkdir -p /home/cursoruser/.config/Cursor && \
    mkdir -p /home/cursoruser/.config/Cursor/Code\ Cache/js && \
    mkdir -p /home/cursoruser/.config/Cursor/Code\ Cache/wasm && \
    mkdir -p /home/cursoruser/.config/Cursor/User/globalStorage && \
    mkdir -p /home/cursoruser/.mozilla/firefox && \
    chown -R cursoruser:cursoruser /home/cursoruser/.config && \
    chown -R cursoruser:cursoruser /home/cursoruser/.cursor && \
    chown -R cursoruser:cursoruser /home/cursoruser/.mozilla && \
    chmod -R 755 /home/cursoruser/.cursor && \
    chmod -R 755 /home/cursoruser/.config/Cursor && \
    chmod -R 755 /home/cursoruser/.mozilla

# Set work directory for that user
USER cursoruser
WORKDIR /home/cursoruser

# Setup custom prompt
RUN echo 'export PS1="\[\033[01;32m\]\u@cursor-container-mac\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ "' >> /home/cursoruser/.bashrc

# Copy Cursor.AppImage with correct permissions
COPY --chown=cursoruser:cursoruser Cursor.AppImage ./Cursor.AppImage
RUN chmod +x Cursor.AppImage

# Create startup script with enhanced browser support
RUN echo '#!/bin/bash\n\
# Ensure permissions are correct at startup\n\
sudo chown -R cursoruser:cursoruser /home/cursoruser/.cursor\n\
sudo chown -R cursoruser:cursoruser /home/cursoruser/.config/Cursor\n\
sudo chown -R cursoruser:cursoruser /home/cursoruser/.mozilla\n\
sudo chmod -R 755 /home/cursoruser/.cursor\n\
sudo chmod -R 755 /home/cursoruser/.config/Cursor\n\
sudo chmod -R 755 /home/cursoruser/.mozilla\n\
\n\
# Start DBus if not running\n\
if [ ! -e /var/run/dbus/system_bus_socket ]; then\n\
  echo "Starting system DBus..."\n\
  sudo mkdir -p /var/run/dbus\n\
  sudo dbus-daemon --system --fork\n\
fi\n\
\n\
# Create xdg-open wrapper that forces browser usage\n\
echo "#!/bin/bash" > /home/cursoruser/custom-xdg-open\n\
echo "if [[ \$1 =~ ^https?:// ]]; then" >> /home/cursoruser/custom-xdg-open\n\
echo "  /usr/bin/chromium-browser --no-sandbox --disable-dev-shm-usage \"\$1\" &" >> /home/cursoruser/custom-xdg-open\n\
echo "else" >> /home/cursoruser/custom-xdg-open\n\
echo "  /usr/bin/xdg-open \"\$1\"" >> /home/cursoruser/custom-xdg-open\n\
echo "fi" >> /home/cursoruser/custom-xdg-open\n\
chmod +x /home/cursoruser/custom-xdg-open\n\
\n\
# Set browser environment for electron apps\n\
export BROWSER="/usr/bin/chromium-browser"\n\
export CHROME_PATH="/usr/bin/chromium-browser"\n\
export ELECTRON_DEFAULT_BROWSER="/usr/bin/chromium-browser"\n\
export DEFAULT_BROWSER="/usr/bin/chromium-browser"\n\
\n\
# Override xdg-open temporarily for browser detection\n\
export PATH="/home/cursoruser:$PATH"\n\
ln -sf /home/cursoruser/custom-xdg-open /home/cursoruser/xdg-open\n\
\n\
# Test browser availability\n\
echo "Testing browser availability..."\n\
chromium-browser --version\n\
\n\
# Start Chromium browser in background with remote debugging\n\
echo "Starting Chromium browser daemon..."\n\
chromium-browser --no-sandbox --disable-dev-shm-usage --disable-gpu-sandbox \\\n\
  --remote-debugging-port=9222 --user-data-dir=/tmp/chromium-profile \\\n\
  --disable-web-security --disable-features=VizDisplayCompositor \\\n\
  --enable-logging --log-level=0 &\n\
BROWSER_PID=$!\n\
\n\
# Wait for browser to initialize\n\
sleep 5\n\
\n\
# Extract AppImage at runtime\n\
echo "Extracting Cursor AppImage..."\n\
mkdir -p ./CursorExtracted\n\
./Cursor.AppImage --appimage-extract\n\
mv squashfs-root/* ./CursorExtracted/\n\
rm -rf squashfs-root\n\
chmod +x ./CursorExtracted/AppRun\n\
\n\
# Start Cursor with browser environment variables\n\
echo "Starting Cursor with browser configuration..."\n\
cd ./CursorExtracted && \\\n\
BROWSER="/usr/bin/chromium-browser" \\\n\
CHROME_PATH="/usr/bin/chromium-browser" \\\n\
ELECTRON_DEFAULT_BROWSER="/usr/bin/chromium-browser" \\\n\
DEFAULT_BROWSER="/usr/bin/chromium-browser" \\\n\
./AppRun --no-sandbox --disable-dev-shm-usage --disable-gpu-sandbox \\\n\
  --enable-logging --log-level=0\n\
\n\
# Clean up browser process when cursor exits\n\
kill $BROWSER_PID 2>/dev/null || true\n\
' > /home/cursoruser/start-cursor.sh && chmod +x /home/cursoruser/start-cursor.sh

# Setup comprehensive browser environment variables
ENV BROWSER="/usr/bin/chromium-browser"
ENV CHROME_PATH="/usr/bin/chromium-browser"
ENV ELECTRON_DEFAULT_BROWSER="/usr/bin/chromium-browser"
ENV DEFAULT_BROWSER="/usr/bin/chromium-browser"
ENV ELECTRON_DEFAULT_ERROR_MODE=1
ENV ELECTRON_ENABLE_LOGGING=1
ENV LIBGL_ALWAYS_INDIRECT=1
ENV XDG_CURRENT_DESKTOP=Unity
ENV XDG_SESSION_TYPE=x11

# Default command
CMD ["/home/cursoruser/start-cursor.sh"]